{
  "name": "github-pr-base-branch-badge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chrome extension — source lives in src/, esbuild + sass bundle it into the gitignored dist/ that manifest.json/popup.html reference",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "node scripts/package.mjs",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.4.2",
    "sass": "^1.101.3"
  }
}
